FLASK_SECRET_KEY=replace-with-a-long-random-value
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
FLASK_COOKIE_SECURE=false

EXPECTED_FUNCTIONS=
EXPECTED_TABLES=
TABLE_NAME_PATTERN=%

CREDENTIALS_DB=database_credentials.sqlite3
APP_USER=developer

# Optional explicit application database URL. If empty, auth and app metadata use PG_* below.
APP_DATABASE_URL=
SESSION_TIMEOUT_MINUTES=30

# Application PostgreSQL settings and defaults for new deployment DB entries.
# PG_PASSWORD is used only server-side and is never rendered into the browser.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=your_local_password
PG_SSLMODE=prefer

ADMIN_BOOTSTRAP_PASSKEY=your_admin_passkey

# --------------------------------------------------
# Database configuration
# --------------------------------------------------

TD_DB_HOST=
TD_DB_PORT=5432
TD_DB_NAME=
TD_DB_USER=
TD_DB_PASSWORD=
TD_DB_SSLMODE=require

LIVE_DB_HOST=
LIVE_DB_PORT=5432
LIVE_DB_NAME=
LIVE_DB_USER=
LIVE_DB_PASSWORD=
LIVE_DB_SSLMODE=require

# --------------------------------------------------
# Brevo SMTP
# --------------------------------------------------

BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_FROM_NAME=PostgreSQL Deployment Manager
NOTIFICATION_EMAIL_TO=

# --------------------------------------------------
# Mobile notification
# --------------------------------------------------

NOTIFICATION_MOBILE_TO=
MOBILE_NOTIFICATION_WEBHOOK=
